#!/usr/bin/env python3
"""
Factor Research Notebook - Interactive factor research

This notebook demonstrates:
1. Factor calculation
2. Factor testing (IC, IR, Group test)
3. Factor visualization
4. Factor correlation analysis

Run in Jupyter for interactive analysis.
"""

# %%
# Setup
import sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd().parent))

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime, timedelta

from src.data import DataManager
from src.factors import FactorEngine, get_all_factors
from src.utils.logger import setup_logger

# Setup logger
setup_logger(log_level="INFO")

# %%
# Load data
dm = DataManager(data_source="mock")

end_date = datetime.now().strftime("%Y-%m-%d")
start_date = (datetime.now() - timedelta(days=365)).strftime("%Y-%m-%d")

symbols = [f"{i:06d}" for i in range(1, 51)]
df = dm.get_daily_data(symbols, start_date, end_date)

print(f"Loaded {len(df)} rows for {df['symbol'].nunique()} stocks")
df.head()

# %%
# Calculate all factors
engine = FactorEngine()
factor_df = engine.calculate_factors(df, show_progress=True)

print(f"Calculated {len([c for c in factor_df.columns if c not in ['symbol', 'date']])} factors")
factor_df.head()

# %%
# Test a single factor
from src.factors.factor_library import Factor001

factor = Factor001()
factor_values = factor.calculate(df)

# Calculate forward returns
df_copy = df.copy()
df_copy["forward_return"] = df_copy.groupby("symbol")["close"].transform(
    lambda x: x.shift(-5) / x - 1
)

# Test factor
tester = engine.tester
result = tester.test_factor(factor, df_copy, forward_periods=[1, 5, 20])

# Display results
print(f"\nFactor: {result['factor_name']}")
print(f"Category: {result['metadata']['category']}")
for period, test in result['tests'].items():
    print(f"\n{period} forward return:")
    print(f"  IC Mean: {test['ic_stats']['ic_mean']:.4f}")
    print(f"  ICIR: {test['ic_stats']['icir']:.4f}")
    print(f"  Monotonicity: {test['monotonicity']:.4f}")
    print(f"  Effective: {test['is_effective']}")

# %%
# Visualize factor test
engine.visualize_factor_test(result, output_path="outputs/factor_test.png")

# %%
# Test all factors
all_results = engine.test_all_factors(df, forward_periods=[1, 5, 20], show_progress=True)

# %%
# Summary table
summary_data = []
for name, result in all_results.items():
    test_20d = result.get("tests", {}).get("20d", {})
    ic_stats = test_20d.get("ic_stats", {})
    
    summary_data.append({
        "Factor": name,
        "Category": result["metadata"]["category"],
        "IC Mean": ic_stats.get("ic_mean", 0),
        "ICIR": ic_stats.get("icir", 0),
        "T-Stat": ic_stats.get("ic_t_stat", 0),
        "Monotonicity": test_20d.get("monotonicity", 0),
        "Effective": test_20d.get("is_effective", False)
    })

summary_df = pd.DataFrame(summary_data)
summary_df = summary_df.sort_values("ICIR", ascending=False)
summary_df

# %%
# Factor correlation heatmap
factor_cols = [c for c in factor_df.columns if c not in ["symbol", "date"]]
corr_matrix = engine.get_factor_correlation(factor_df)

plt.figure(figsize=(12, 10))
sns.heatmap(corr_matrix, annot=True, fmt=".2f", cmap="RdBu", center=0)
plt.title("Factor Correlation Matrix")
plt.tight_layout()
plt.savefig("outputs/factor_correlation.png", dpi=150)
plt.show()

# %%
# Group test visualization
factor_name = "Factor001"
factor_test = all_results[factor_name]["tests"]["20d"]

group_stats = factor_test.get("group_stats", [])
if group_stats:
    groups = [g["group"] for g in group_stats]
    returns = [g["mean_return"] * 100 for g in group_stats]
    
    plt.figure(figsize=(10, 6))
    plt.bar(groups, returns, alpha=0.7)
    plt.xlabel("Group (1=Low, 5=High)")
    plt.ylabel("Mean Forward Return (%)")
    plt.title(f"{factor_name} - Group Returns")
    plt.axhline(y=0, color="gray", linestyle="--")
    plt.grid(True, alpha=0.3)
    plt.savefig("outputs/group_returns.png", dpi=150)
    plt.show()

# %%
# IC time series for a factor
factor_name = "Factor001"
factor = next(f for f in get_all_factors() if f.name == factor_name)
factor_values = factor.calculate(df)

df_copy = df.copy()
df_copy["forward_return"] = df_copy.groupby("symbol")["close"].transform(
    lambda x: x.shift(-5) / x - 1
)

ic_df = tester.calculate_ic(factor_values, df_copy)

plt.figure(figsize=(12, 6))
plt.bar(ic_df["date"], ic_df["ic"], alpha=0.7)
plt.axhline(y=0, color="gray", linestyle="--")
plt.axhline(y=ic_df["ic"].mean(), color="red", linestyle="-", label=f"Mean IC: {ic_df['ic'].mean():.4f}")
plt.xlabel("Date")
plt.ylabel("IC")
plt.title(f"{factor_name} - IC Time Series")
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig("outputs/ic_timeseries.png", dpi=150)
plt.show()

# %%
print("Factor research complete!")
